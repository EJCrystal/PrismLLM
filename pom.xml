<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.soven</groupId>
    <artifactId>prism-llm-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>PrismLLM</name>
    <description>OpenAI-compatible LLM gateway with canonical model routing, streaming pass-through and admin API.</description>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>prism-shared</module>
        <module>prism-protocol</module>
        <module>prism-channel</module>
        <module>prism-routing</module>
        <module>prism-resilience</module>
        <module>prism-subscription-oauth</module>
        <module>prism-quota</module>
        <module>prism-pricing</module>
        <module>prism-request-log</module>
        <module>prism-admin</module>
        <module>prism-app</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>21</java.version>
        <kotlin.version>2.3.21</kotlin.version>
        <ktor.version>3.6.0</ktor.version>
        <exposed.version>1.6.0</exposed.version>
        <coroutines.version>1.11.0</coroutines.version>
        <serialization.version>1.11.0</serialization.version>
        <hikari.version>7.1.0</hikari.version>
        <postgresql.version>42.7.14</postgresql.version>
        <flyway.version>13.10.3</flyway.version>
        <logback.version>1.6.5</logback.version>
        <slf4j.version>2.0.19</slf4j.version>
        <logstash.version>9.0</logstash.version>
        <micrometer.version>1.17.1</micrometer.version>
        <guava.version>33.5.0-jre</guava.version>
        <re2j.version>1.8</re2j.version>
        <bcprov.version>1.86</bcprov.version>
        <junit.version>5.13.4</junit.version>
        <mockk.version>1.14.11</mockk.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>dev.soven</groupId>
                <artifactId>prism-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.soven</groupId>
                <artifactId>prism-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.soven</groupId>
                <artifactId>prism-channel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.soven</groupId>
                <artifactId>prism-routing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.soven</groupId>
                <artifactId>prism-resilience</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.soven</groupId>
                <artifactId>prism-subscription-oauth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.soven</groupId>
                <artifactId>prism-quota</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.soven</groupId>
                <artifactId>prism-pricing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.soven</groupId>
                <artifactId>prism-request-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.soven</groupId>
                <artifactId>prism-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <executions>
                        <execution>
                            <id>compile</id>
                            <phase>process-sources</phase>
                            <goals><goal>compile</goal></goals>
                        </execution>
                        <execution>
                            <id>test-compile</id>
                            <phase>process-test-sources</phase>
                            <goals><goal>test-compile</goal></goals>
                        </execution>
                    </executions>
                    <configuration>
                        <jvmTarget>21</jvmTarget>
                        <compilerPlugins>
                            <plugin>kotlinx-serialization</plugin>
                        </compilerPlugins>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.jetbrains.kotlin</groupId>
                            <artifactId>kotlin-maven-serialization</artifactId>
                            <version>${kotlin.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

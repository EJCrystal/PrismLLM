PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/llm_gateway
DATABASE_USER=llm_gateway
DATABASE_PASSWORD=llm_gateway
GATEWAY_MASTER_KEY=replace-with-openssl-rand-base64-32
CONNECT_TIMEOUT_MS=30000
# Container-wide proxy defaults are stored in Dockerfile and docker-compose.yml.
# Change gateway.environment in Compose to override or disable those defaults.
# PR-Agent streaming: wait up to 120s for the first token before model fallback
FIRST_TOKEN_TIMEOUT_MS=120000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
CORS_ORIGINS=
STATIC_DIR=web/dist
REQUEST_LOG_RETENTION_DAYS=30
REQUEST_LOG_CLEANUP_ENABLED=true
REQUEST_LOG_CLEANUP_INTERVAL_MS=3600000
REQUEST_LOG_CLEANUP_BATCH_SIZE=5000
# Optional HTTPS manifest for full profile overrides, including Antigravity.
UPSTREAM_HEADER_CATALOG_URL=
UPSTREAM_HEADER_REFRESH_ENABLED=true
UPSTREAM_HEADER_REFRESH_INTERVAL_MS=3600000
# Optional trusted channel-quota provider JAR directory.
QUOTA_PLUGIN_DIR=plugins

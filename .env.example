PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/llm_gateway
DATABASE_USER=llm_gateway
DATABASE_PASSWORD=llm_gateway
GATEWAY_MASTER_KEY=replace-with-openssl-rand-base64-32
CONNECT_TIMEOUT_MS=30000
# Optional container-wide outbound proxy. Leave unset for direct connections.
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1,::1,postgres
# Ktor's Java HTTP engine also needs JVM proxy properties. Preserve any other
# existing JVM options when adding these; include matching http.nonProxyHosts.
# JAVA_TOOL_OPTIONS=-Dhttp.proxyHost=proxy.example -Dhttp.proxyPort=8080 -Dhttps.proxyHost=proxy.example -Dhttps.proxyPort=8080 -Dhttp.nonProxyHosts=localhost|127.*|[::1]|postgres
# Streaming: wait up to 120s for the first token before model fallback
FIRST_TOKEN_TIMEOUT_MS=120000
# Candidate cooldown and automatic key recovery. Durations are milliseconds.
# 429 cooldowns honor Retry-After but never exceed COOLDOWN_RATE_LIMIT_MAX_MS.
COOLDOWN_TRANSIENT_BASE_MS=30000
COOLDOWN_TRANSIENT_MAX_MS=600000
COOLDOWN_RATE_LIMIT_DEFAULT_MS=30000
COOLDOWN_RATE_LIMIT_MAX_MS=60000
COOLDOWN_AUTH_FAILURE_MS=600000
TTFT_SLOW_THRESHOLD_MS=10000
TTFT_SLOW_STREAK=3
KEY_AUTO_RECOVERY_INTERVAL_MS=30000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
CORS_ORIGINS=
# Optional: let the gateway run Responses built-in web_search for Chat-only
# upstreams by injecting a normal web_search function tool.
# These values are defaults for the admin UI (System config -> Web search);
# settings saved there take precedence and apply without a restart.
# Omit WEB_SEARCH_ENABLED to auto-enable when WEB_SEARCH_API_KEY is set.
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_BASE_URL=
# WEB_SEARCH_MAX_RESULTS=6
# WEB_SEARCH_TIMEOUT_MS=15000
# WEB_SEARCH_MAX_ROUNDS=6
# WEB_SEARCH_MAX_PAGE_CHARS=1500
# Optional trusted reverse proxy addresses/CIDRs; only these peers may supply forwarded client IP headers.
TRUSTED_PROXY_CIDRS=
STATIC_DIR=web/dist

# 智商检测：默认使用本地结构判分器（local），可切换满血AI 或外部 JAR 判分器。
# 选择 manxue 时会把模型生成的 HTML 发送到 manxue.ai；不允许访问第三方服务时设为 false。
IQ_DEFAULT_JUDGE=local
# 单次判分总超时；留空时普通判分为 60000，启用 vision 时按 6×浏览器单帧超时+视觉超时自动计算。
# IQ_JUDGE_TIMEOUT_MS=60000
# 外部判分器 JAR 目录；JAR 通过 META-INF/services/dev.soven.llmgateway.spi.iq.IqJudge 注册。
IQ_JUDGE_PLUGIN_DIR=plugins/iq-judges
MANXUE_ENABLED=true
MANXUE_API_BASE_URL=https://manxue.ai
MANXUE_TIMEOUT_MS=60000
# 内置视觉判分器：用无头浏览器在动画周期内采样 6 帧截图，再调用 OpenAI 兼容的多模态端点逐项评分。
# 截图只会发到 IQ_VISION_BASE_URL；渠道密钥不会传给判分器。默认关闭。
IQ_VISION_ENABLED=false
IQ_VISION_BASE_URL=
IQ_VISION_API_KEY=
IQ_VISION_MODEL=
IQ_VISION_TIMEOUT_MS=60000
IQ_VISION_RENDER_WIDTH=1024
IQ_VISION_MAX_IMAGE_BYTES=4000000
# 视觉判分只使用无头浏览器；未找到时该判分器返回“需人工查看”，不会改用其他渲染器。
# Docker amd64 镜像已预装 Chrome；其他环境可填 Chrome/Chromium 可执行文件路径。
IQ_VISION_BROWSER_PATH=
IQ_VISION_BROWSER_TIMEOUT_MS=15000

REQUEST_LOG_RETENTION_DAYS=30
REQUEST_LOG_CLEANUP_ENABLED=true
REQUEST_LOG_CLEANUP_INTERVAL_MS=3600000
REQUEST_LOG_CLEANUP_BATCH_SIZE=5000
# Optional HTTPS manifest for full profile overrides, including Antigravity.
UPSTREAM_HEADER_CATALOG_URL=
UPSTREAM_HEADER_REFRESH_ENABLED=true
UPSTREAM_HEADER_REFRESH_INTERVAL_MS=3600000
# Optional trusted channel-quota provider JAR directory.
QUOTA_PLUGIN_DIR=plugins
# Subscription account OAuth refresh (ChatGPT / Antigravity).
# Requests lazily refresh expired tokens; the background sweep only warms tokens.
OAUTH_REFRESH_INTERVAL_MS=300000
OAUTH_REFRESH_AHEAD_MS=900000
OAUTH_REQUEST_TIMEOUT_MS=30000
# Account-level 429 cooldown. A reset hint from the upstream wins; otherwise the
# cooldown starts at the default and doubles for consecutive 429s up to the max.
OAUTH_RATE_LIMIT_DEFAULT_MS=300000
OAUTH_RATE_LIMIT_MAX_MS=21600000
# Upstream quota observation. The sweep reads each ChatGPT account's /wham/usage
# every interval; readings older than the max age are shown but stop gating.
OAUTH_QUOTA_INTERVAL_MS=300000
OAUTH_QUOTA_MAX_AGE_MS=900000
# Subscription accounts in one channel and key-priority tier can be ordered by
# round_robin (default), drain (fill one account before the next), least_used,
# or pace (most remaining quota per hour until reset).
OAUTH_ROUTING=round_robin
# Account proxy hosts. Loopback (127.0.0.1, localhost, ::1) is always allowed;
# any other proxy host must be listed here as a bare host name or IPv4 address
# (comma separated, no scheme, port, path or credentials).
# OAUTH_PROXY_ALLOWED_HOSTS=proxy.example.com,10.0.0.12
OAUTH_CHATGPT_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
OAUTH_CHATGPT_TOKEN_ENDPOINT=https://auth.openai.com/oauth/token
OAUTH_CHATGPT_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
# Interactive login. The redirect URI must stay on a loopback host and match a
# client registered with the provider; it is also the address the browser lands
# on, so paste that full URL back into the admin page.
OAUTH_CHATGPT_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
OAUTH_CHATGPT_REDIRECT_URI=http://localhost:1455/auth/callback
OAUTH_CHATGPT_LOGIN_SCOPES=openid profile email offline_access api.connectors.read api.connectors.invoke
# Antigravity is registered only when a client id is configured.
# OAUTH_ANTIGRAVITY_CLIENT_ID=
# OAUTH_ANTIGRAVITY_CLIENT_SECRET=
# OAUTH_ANTIGRAVITY_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
